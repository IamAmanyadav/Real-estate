# Luxe Estates API — Environment Variables Template
# Copy this file to .env and fill in your values.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/luxe_estates
APP_NAME=Luxe Estates API
APP_VERSION=1.0.0
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Admin Credentials (used by seed scripts)
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-admin-password

# Resend (Email Service) — Get your API key from https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:3000
# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
